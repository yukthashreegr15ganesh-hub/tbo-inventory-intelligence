# TBO Inventory Intelligence 2.0 - Production Environment Variables

# Infrastructure
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
WORKERS=2

# Database Connectivity (PostgreSQL)
# When unset or unreachable, falls back seamlessly to persistent SQLite
DATABASE_URL=postgresql://tbo_user:tbo_secure_pass_2026@localhost:5432/tbo_inventory
POSTGRES_USER=tbo_user
POSTGRES_PASSWORD=tbo_secure_pass_2026
POSTGRES_DB=tbo_inventory

# Security & Authentication (RBAC)
SECRET_KEY=tbo_enterprise_jwt_secret_key_2026_production_v2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_REQUIRED=false

# Networking & CORS
CORS_ORIGINS=*

# File Upload Guardrails
MAX_UPLOAD_BYTES=26214400  # 25 MB
